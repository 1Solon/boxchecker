# Each stage talks to any OpenAI-compatible endpoint. URLs include the /v1 prefix.

# Local whisper.cpp: whisper-server -m ggml-large-v3-turbo.bin --port 8178 --inference-path /v1/audio/transcriptions
BOXCHECKER_TRANSCRIPTION_URL=http://127.0.0.1:8178/v1
BOXCHECKER_TRANSCRIPTION_MODEL=whisper-1

BOXCHECKER_SCREENING_URL=http://localhost:8080/v1
BOXCHECKER_SCREENING_MODEL=
# BOXCHECKER_SCREENING_API_KEY=

BOXCHECKER_VERIFICATION_URL=http://localhost:8080/v1
BOXCHECKER_VERIFICATION_MODEL=
# BOXCHECKER_VERIFICATION_API_KEY=

BOXCHECKER_FIRECRAWL_URL=http://localhost:3002
