{
  "name": "boxchecker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Listens to a spoken conversation and fact-checks its claims as it unfolds.",
  "bin": {
    "boxchecker": "./src/cli.ts"
  },
  "scripts": {
    "boxchecker": "node --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.3",
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
